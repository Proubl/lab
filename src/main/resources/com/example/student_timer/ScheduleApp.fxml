<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.student_timer.Controller" spacing="10" alignment="center">
    <Label fx:id="scheduleLabel" text="Следующая пара: Не определена"/>
    <Label fx:id="timeLabel" text="Время: 00:00 - 00:00"/>
    <Label fx:id="timeRemainingLabel" text="До начала: 0 минут"/>
    <Button fx:id="loadFileButton" text="Загрузить расписание" onAction="#loadScheduleFile"/>
    <Button fx:id="startButton" text="Начать уведомления" onAction="#startNotifications"/>
    <Button fx:id="stopButton" text="Остановить уведомления" onAction="#stopNotifications"/>
    <TextField fx:id="intervalTextField" promptText="Интервал в минутах"/>
    <Button text="Установить интервал" onAction="#setNotificationInterval"/>
</VBox>
